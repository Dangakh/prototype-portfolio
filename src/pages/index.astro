---
import Layout from '../layouts/Layout.astro';
import { getPageData } from '../lib/sanity';
import type { Client } from '../lib/sanity';

const { settings, clients } = await getPageData();

// Hero slideshow. Slide 1 is the intro (fed by Sanity siteSettings).
// Slides 2-4 are highlighted client projects, hardcoded for now with
// placeholder taglines + imagery; they can move into Sanity later.
const heroSlides = [
  {
    num: '01',
    role: settings.heroRole,
    heading: 'Dang Khoa Nguyen',
    tagline: settings.heroTagline,
    image: '/UpscaledHero.jpeg',
    alt: 'Dang Khoa working on a laptop on a hilltop above the clouds',
    size: 'lg',
  },
  {
    num: '02',
    role: 'Web Platform / Product Design',
    heading: 'Skypass',
    tagline: 'A calm, end-to-end booking experience for travellers who move between cities and seasons.',
    image: '/projects/skypass.jpg',
    alt: 'Ski lift chairs hanging in teal fog, placeholder visual for the Skypass project',
    size: 'lg',
  },
  {
    num: '03',
    role: 'Branding / Digital Strategy',
    heading: 'Innovasjon Norge',
    tagline: 'Digital storytelling and brand work supporting Norwegian innovation on the international stage.',
    image: '/projects/innovasjon.jpg',
    alt: 'Sunlight breaking through a Nordic pine forest, placeholder visual for the Innovasjon Norge project',
    size: 'sm',
  },
  {
    num: '04',
    role: 'Media Production / UX',
    heading: 'NTNU',
    tagline: 'Media production and user experience work for one of the largest universities in Norway.',
    image: '/projects/ntnu.jpg',
    alt: 'Dark macro texture of water droplets, placeholder visual for the NTNU project',
    size: 'lg',
  },
];
---

<Layout title="Dang Khoa Nguyen - Portfolio">
  <div class="portfolio">

    <!-- HERO -->
    <section class="hero panel panel--stick" id="hero">
      {heroSlides.map((slide, i) => (
        <img
          src={slide.image}
          alt={slide.alt}
          class="hero-img"
          data-hero-img={i}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          aria-hidden={i === 0 ? undefined : 'true'}
        />
      ))}
      <div class="hero-overlay"></div>
      <div class="hero-grid">
        <div class="logo">Dang<br>Khoa</div>
        <div class="label-num" data-hero-num>/ {heroSlides[0].num}</div>
        <div class="label-role" data-hero-role>/ {heroSlides[0].role}</div>
        <div class="wordmark-wrap" aria-live="polite">
          <h1 class="wordmark" data-hero-heading data-size={heroSlides[0].size}>{heroSlides[0].heading}</h1>
        </div>
        <div class="prev-next">
          <button type="button" class="hero-nav prev" data-hero-prev aria-label="Previous highlight">PREV</button>
          <span class="nav-sep">/</span>
          <button type="button" class="hero-nav next" data-hero-next aria-label="Next highlight">NEXT</button>
          <span class="num-inline" data-hero-num>/ {heroSlides[0].num}</span>
        </div>
        <div class="hero-right">
          <p data-hero-tagline>{heroSlides[0].tagline}</p>
        </div>
      </div>
    </section>

    <!-- INTRODUCTION -->
    <section class="intro-grid panel">
      <div class="intro-label">/ Introduction</div>
      <p class="intro-text reveal">{settings.introBio}</p>
    </section>

    <!-- WHO I HAVE WORKED WITH -->
    <section class="clients-grid panel">
      <div class="clients-heading reveal">Who i have<br>worked with</div>

      <div class="clients-logo-grid">
        {clients.map((client: Client) => (
          <div class="client-cell">
            {client.logoUrl ? (
              <img src={client.logoUrl} alt={client.name} class="client-logo-img" />
            ) : client.logoKey === 'innovasjon-norge' ? (
              <div class="logo-innovasjon"><div class="inn-icon"><span class="inn-dot inn-dot--tl"></span><span class="inn-dot inn-dot--bl"></span><span class="inn-slash"></span></div><div class="inn-name">Innovasjon<br>Norge</div></div>
            ) : client.logoKey === 'ntnu' ? (
              <div class="logo-ntnu"><span class="ntnu-sq"></span><div><div class="ntnu-text">NTNU</div><div class="ntnu-sub">Kunnskap for en bedre verden</div></div></div>
            ) : client.logoKey === 'skypass' ? (
              <div class="logo-skypass"><svg width="34" height="30" viewBox="0 0 34 30" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M17 3 L31 11 L17 19 L3 11 Z"></path><path d="M3 11 L3 19 L17 27 L17 19"></path><path d="M31 11 L31 19 L17 27"></path></svg><span class="sky-text">SKYPASS</span></div>
            ) : null}
          </div>
        ))}
      </div>
    </section>

    <!-- EXPERTISE -->
    <section class="expertise-grid panel">
      <div class="expertise-text">
        <span class="exp-item">Digital Strategy<sup>01</sup></span>
        <span class="exp-div">/</span>
        <span class="exp-item">Branding<sup>02</sup></span>
        <br>
        <span class="exp-item">Web + App Development<sup>03</sup></span>
        <span class="exp-div">/</span>
        <br>
        <span class="exp-item">User Experience<sup>04</sup></span>
        <span class="exp-div">/</span>
        <span class="exp-item">Digital Marketing<sup>05</sup></span>
        <br>
        <span class="exp-item">Media Production<sup>06</sup></span>
        <a href="#" class="exp-link">
          <span>Explore all Expertise</span>
          <span class="exp-arrow">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact-grid panel">
      <div class="contact-label">/ Contact</div>
      <h2 class="contact-heading reveal">Let's work<br>together</h2>
      <a href="mailto:khoa@khoa.studio" class="contact-link reveal">
        <span>khoa@khoa.studio</span>
        <span class="contact-arrow">&rarr;</span>
      </a>
      <footer class="footer">
        <span>&copy; 2026 Dang Khoa Nguyen</span>
      </footer>
    </section>

  </div>
</Layout>

<script type="application/json" id="hero-data" is:inline set:html={JSON.stringify(heroSlides)}></script>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var heroTargets = ['.hero-img:first-of-type', '.hero-overlay', '.logo', '.label-num', '.label-role', '.wordmark', '.hero-right p', '.prev-next'];

    /* ── Hero entrance ─────────────────────────────────────── */
    function runHeroAnimation() {
      var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.from('.hero-img:first-of-type', { scale: 1.06, autoAlpha: 0, duration: 2.0, ease: 'power2.out' }, 0);
      tl.from('.hero-overlay', { autoAlpha: 0, duration: 1.4 }, 0.1);
      tl.from('.logo', { y: -10, autoAlpha: 0, duration: 0.75 }, 0.55);
      tl.from('.label-num', { y: 10, autoAlpha: 0, duration: 0.65 }, 0.7);
      tl.from('.label-role', { y: 10, autoAlpha: 0, duration: 0.65 }, 0.78);
      tl.from('.hero-right p', { x: 16, autoAlpha: 0, duration: 0.8 }, 0.82);
      tl.from('.wordmark', { y: 32, autoAlpha: 0, duration: 1.05, ease: 'power4.out' }, 0.9);
      tl.from('.prev-next', { y: 10, autoAlpha: 0, duration: 0.6 }, 1.12);
    }

    /* ── Hero slideshow ────────────────────────────────────── */
    function initSlideshow() {
      var slides = JSON.parse(document.getElementById('hero-data').textContent);
      var imgs = Array.prototype.slice.call(document.querySelectorAll('[data-hero-img]'));
      var numEls = Array.prototype.slice.call(document.querySelectorAll('[data-hero-num]'));
      var roleEl = document.querySelector('[data-hero-role]');
      var headingEl = document.querySelector('[data-hero-heading]');
      var tagEl = document.querySelector('[data-hero-tagline]');
      var current = 0;
      var animating = false;

      function setText(i) {
        numEls.forEach(function (el) { el.textContent = '/ ' + slides[i].num; });
        roleEl.textContent = '/ ' + slides[i].role;
        headingEl.textContent = slides[i].heading;
        headingEl.setAttribute('data-size', slides[i].size);
        tagEl.textContent = slides[i].tagline;
      }

      function setImage(prev, next) {
        imgs[prev].setAttribute('aria-hidden', 'true');
        imgs[next].removeAttribute('aria-hidden');
      }

      function goTo(target) {
        var idx = ((target % slides.length) + slides.length) % slides.length;
        if (animating || idx === current) return;
        var prev = current;
        current = idx;

        if (reduce || !window.gsap) {
          imgs[prev].style.opacity = '0';
          imgs[idx].style.opacity = '1';
          setImage(prev, idx);
          setText(idx);
          return;
        }

        animating = true;
        var textOut = [roleEl, headingEl, tagEl];
        var tl = gsap.timeline({
          onComplete: function () {
            gsap.set(imgs[prev], { autoAlpha: 0 });
            gsap.set(imgs[idx], { zIndex: 0 });
            animating = false;
          },
        });

        // Out: current text lifts away
        tl.to(textOut, { y: -18, autoAlpha: 0, duration: 0.4, ease: 'power2.in', stagger: 0.05 }, 0);
        tl.to(numEls, { y: -10, autoAlpha: 0, duration: 0.3, ease: 'power2.in' }, 0);

        // Crossfade: incoming image scales down into place on top
        tl.set(imgs[idx], { zIndex: 1, autoAlpha: 0, scale: 1.06 }, 0);
        tl.call(function () { setImage(prev, idx); }, null, 0.1);
        tl.to(imgs[idx], { autoAlpha: 1, scale: 1, duration: 1.2, ease: 'power2.out' }, 0.1);

        // Swap content, then mirror the entrance
        tl.call(function () { setText(idx); }, null, 0.48);
        tl.fromTo(numEls, { y: 12, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.5, ease: 'power3.out' }, 0.55);
        tl.fromTo(roleEl, { y: 14, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.55, ease: 'power3.out' }, 0.6);
        tl.fromTo(headingEl, { y: 34, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.85, ease: 'power4.out' }, 0.58);
        tl.fromTo(tagEl, { x: 16, autoAlpha: 0 }, { x: 0, autoAlpha: 1, duration: 0.6, ease: 'power3.out' }, 0.66);
      }

      document.querySelector('[data-hero-prev]').addEventListener('click', function () { goTo(current - 1); });
      document.querySelector('[data-hero-next]').addEventListener('click', function () { goTo(current + 1); });

      document.addEventListener('keydown', function (e) {
        // The hero is sticky, so use scroll position (not its rect) to
        // decide whether it is still the section on screen.
        if (window.scrollY > window.innerHeight * 0.6) return;
        if (e.key === 'ArrowRight') goTo(current + 1);
        if (e.key === 'ArrowLeft') goTo(current - 1);
      });
    }

    /* ── Section overlap + scroll reveals ──────────────────── */
    function initScrollEffects() {
      if (!window.ScrollTrigger) return;
      gsap.registerPlugin(ScrollTrigger);

      // Unmask on scroll: every .panel--stick pins (CSS sticky) while the
      // next section slides over it; this scrub dims the pinned panel as
      // it gets covered. No scale: the panel must stay full-bleed. The
      // dim starts only after the next section has covered ~25% of the
      // viewport. To extend the effect to more sections, just add the
      // panel--stick class to them.
      gsap.utils.toArray('.panel--stick').forEach(function (panel) {
        var next = panel.nextElementSibling;
        if (!next) return;
        gsap.to(panel, {
          opacity: 0.3,
          ease: 'none',
          scrollTrigger: {
            trigger: next,
            start: 'top 75%',
            end: 'top top',
            scrub: true,
          },
        });
      });

      // Inner reveals
      gsap.utils.toArray('.reveal').forEach(function (el) {
        gsap.from(el, {
          y: 36,
          autoAlpha: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        });
      });

      gsap.from('.client-cell', {
        y: 24,
        autoAlpha: 0,
        duration: 0.7,
        ease: 'power3.out',
        stagger: 0.08,
        scrollTrigger: { trigger: '.clients-logo-grid', start: 'top 82%', once: true },
      });

      gsap.from('.exp-item', {
        y: 28,
        autoAlpha: 0,
        duration: 0.8,
        ease: 'power3.out',
        stagger: 0.07,
        scrollTrigger: { trigger: '.expertise-text', start: 'top 80%', once: true },
      });
    }

    function init() {
      initSlideshow();
      if (reduce || !window.gsap) {
        if (window.gsap) gsap.set(heroTargets, { autoAlpha: 1 });
        return;
      }
      runHeroAnimation();
      initScrollEffects();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  ::selection { background: #F2EED5; color: #0a0a0a; }

  .portfolio {
    background: #0a0a0a;
    width: 100%;
    min-height: 100vh;
    font-family: 'Schibsted Grotesk', sans-serif;
    color: #ededed;
    overflow-x: clip;
  }

  /* ── STACKING PANELS ───────────────────────────────────────
     Every section is a .panel (opaque, isolated stacking layer).
     Add .panel--stick to a section to pin it so the NEXT section
     scrolls over it and unmasks it (currently: hero only).
     The scrub dim/scale in the script picks it up automatically. */
  .panel {
    position: relative;
    isolation: isolate;
    background: #0a0a0a;
  }

  .panel--stick {
    min-height: 100vh;
    min-height: 100svh;
  }

  .panel--stick + .panel {
    box-shadow: 0 -60px 120px -30px rgba(0, 0, 0, 0.9);
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel--stick { position: sticky; top: 0; }
  }

  /* ── HERO ──────────────────────────────────────────────── */
  .hero {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 5%;
    z-index: 0;
    opacity: 0;
    will-change: transform, opacity;
  }

  .hero-img:first-of-type { opacity: 1; }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgba(10,10,10,0.94) 0%, rgba(10,10,10,0.28) 40%, rgba(10,10,10,0.06) 64%),
      linear-gradient(rgba(10,10,10,0.16), rgba(10,10,10,0.16));
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.25rem;          /* 20px */
    grid-template-rows: auto 1fr auto auto auto;
    padding: 2.125rem 4rem clamp(3rem, 6vh, 6rem);
  }

  .logo {
    grid-column: 2 / 5;
    grid-row: 1;
    align-self: start;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    font-size: 1.3125rem;         /* 21px */
    line-height: 0.98;
    letter-spacing: -0.01em;
    color: #f6f6f0;
  }

  .label-num {
    grid-column: 1 / 2;
    grid-row: 3;
    align-self: end;
    margin-bottom: 1rem;          /* 16px */
    font-size: 0.906rem;          /* 14.5px */
    letter-spacing: 0.01em;
    color: #e7e3d6;
    white-space: nowrap;
  }

  .label-role {
    grid-column: 2 / 9;
    grid-row: 3;
    align-self: end;
    margin-bottom: 1rem;          /* 16px */
    font-size: 0.906rem;          /* 14.5px */
    letter-spacing: 0.01em;
    color: #bdb9ad;
  }

  .wordmark-wrap {
    grid-column: 2 / 8;
    grid-row: 4;
    align-self: end;
    container-type: inline-size;
  }

  .wordmark {
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    font-size: 8rem;              /* 128px */
    line-height: 0.82;
    letter-spacing: -0.01em;
    color: #F2EED5;
    padding-left: 0;
    margin-left: 0;
  }

  .wordmark[data-size="sm"] { font-size: 5.25rem; }

  .prev-next {
    grid-column: 2 / 8;
    grid-row: 5;
    align-self: start;
    margin-top: clamp(2.5rem, 6vh, 5.5rem);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.5rem;            /* 24px */
    letter-spacing: 0.02em;
  }

  .hero-nav {
    font: inherit;
    letter-spacing: inherit;
    background: none;
    border: none;
    padding: 0.25rem 0;
    cursor: pointer;
    position: relative;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-nav::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-nav:hover::after,
  .hero-nav:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .hero-nav:active { transform: translateY(1px); }

  .hero-nav:focus-visible {
    outline: 1px solid #F2EED5;
    outline-offset: 4px;
  }

  .prev { color: #f0ece0; }
  .next { color: #8f8b80; }
  .next:hover, .next:focus-visible { color: #f0ece0; }
  .nav-sep { color: #8f8b80; }

  .num-inline {
    display: none;
    margin-left: auto;
    font-size: 0.906rem;
    color: #e7e3d6;
  }

  .hero-right {
    grid-column: 10 / 13;
    grid-row: 1 / 6;
    align-self: end;
  }

  .hero-right p {
    font-size: 1rem;              /* 16px */
    line-height: 1.42;
    color: #d6d2c7;
  }

  /* ── INTRODUCTION ──────────────────────────────────────── */
  .intro-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.25rem;          /* 20px */
    align-content: center;
    padding: 8rem 4rem;
    row-gap: 2.625rem;            /* 42px */
  }

  .intro-label {
    grid-column: 2 / 5;
    font-size: 0.906rem;          /* 14.5px */
    color: #8f8b80;
    letter-spacing: 0.01em;
  }

  .intro-text {
    grid-column: 2 / 8;
    font-size: 2.5625rem;         /* 41px */
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: #efece4;
  }

  /* ── WHO I HAVE WORKED WITH ────────────────────────────── */
  .clients-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.25rem;          /* 20px */
    row-gap: 5.25rem;             /* 84px */
    align-content: center;
    padding: 8rem 4rem;
    align-items: center;
  }

  .clients-heading {
    grid-column: 2 / 5;
    grid-row: 1 / 3;
    align-self: start;
    font-size: 1.3125rem;         /* 21px */
    line-height: 1.25;
    color: #efece4;
  }

  .clients-logo-grid {
    grid-column: 5 / 13;
    grid-row: 1 / 3;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    column-gap: 1.25rem;          /* 20px */
    row-gap: 5.25rem;             /* 84px */
    align-content: start;
    align-items: center;
  }

  .client-cell {
    justify-self: center;
    opacity: 0.62;
    color: #dcdcdc;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .client-cell:hover { opacity: 1; }

  .client-logo-img {
    max-height: 2.875rem;         /* 46px */
    max-width: 8.75rem;           /* 140px */
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  /* Innovasjon Norge */
  .logo-innovasjon {
    display: flex;
    align-items: center;
    height: 2.875rem;             /* 46px */
    gap: 0.6875rem;               /* 11px */
  }

  .inn-icon {
    position: relative;
    width: 1.625rem;              /* 26px */
    height: 1.875rem;             /* 30px */
    flex-shrink: 0;
  }

  .inn-dot {
    position: absolute;
    width: 0.5rem;                /* 8px */
    height: 0.5rem;
    background: currentColor;
  }

  .inn-dot--tl { left: 0; top: 0; }
  .inn-dot--bl { left: 0; bottom: 0; }

  .inn-slash {
    position: absolute;
    right: 1px;
    top: 0;
    width: 0.4375rem;             /* 7px */
    height: 1.875rem;             /* 30px */
    background: currentColor;
    transform: skewX(-16deg);
    transform-origin: bottom;
  }

  .inn-name {
    font-family: 'Schibsted Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.0625rem;         /* 17px */
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  /* NTNU */
  .logo-ntnu {
    display: flex;
    align-items: center;
    height: 2.875rem;             /* 46px */
    gap: 0.5625rem;               /* 9px */
  }

  .ntnu-sq {
    width: 1.0625rem;             /* 17px */
    height: 1.0625rem;
    background: currentColor;
    border-radius: 0.1875rem;     /* 3px */
    flex-shrink: 0;
  }

  .ntnu-text {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: 1.5rem;            /* 24px */
    line-height: 0.9;
    letter-spacing: 0.01em;
  }

  .ntnu-sub {
    font-size: 0.53125rem;        /* 8.5px */
    letter-spacing: 0.01em;
    color: #9c9c9c;
  }

  /* Skypass */
  .logo-skypass {
    display: flex;
    align-items: center;
    height: 2.875rem;             /* 46px */
    gap: 0.75rem;                 /* 12px */
  }

  .sky-text {
    font-weight: 500;
    font-size: 1rem;              /* 16px */
    letter-spacing: 0.22em;
  }

  /* ── EXPERTISE ─────────────────────────────────────────── */
  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.25rem;          /* 20px */
    align-content: center;
    padding: 8rem 4rem;
  }

  .expertise-text {
    grid-column: 2 / 13;
    font-family: 'Schibsted Grotesk', sans-serif;
    font-weight: 400;
    font-size: 4.3125rem;         /* 69px */
    line-height: 1.16;
    letter-spacing: -0.02em;
    color: #f3f0e8;
  }

  .exp-item {
    white-space: nowrap;
    display: inline-block;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .exp-item:hover { color: #ffffff; }

  .exp-item sup {
